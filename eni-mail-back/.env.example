# === ENI Mail backend — exemple d'environnement ===
# Copier ce fichier en `.env` (jamais commite) ou exporter ces variables avant demarrage.

SPRING_PROFILES_ACTIVE=dev
# 8080 est souvent occupe (Oracle/EDB/Jenkins) ; 8088 par defaut.
SERVER_PORT=8089

# Base MongoDB
MONGODB_URI=mongodb://localhost:27017/eni_mail_dev

# JWT - secret minimum 32 octets
JWT_SECRET=please-change-this-secret-to-a-random-32-byte-value
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stockage des pieces jointes
ATTACHMENTS_PATH=./data/uploads

# Compte administrateur de demonstration (seed au premier demarrage uniquement)
SEED_ADMIN_EMAIL=admin@eni.mg
SEED_ADMIN_PASSWORD=Admin@2026!
